{
  "name": "dsh-cursor-modes",
  "version": "0.3.0",
  "private": false,
  "description": "Cursor-style modes for the Harness web UI: plan mode, multitask delegation, the create_plan tool and the delegation gate. Since 0.2.1 it also owns the subagent todos handover: the `todos` parameter on `subagent` and `subagent_fork`, and the child todo seed that rides it.",
  "repository": "https://github.com/YukimuraSol/dsh-cursor-modes.git",
  "license": "MIT",
  "author": "YukimuraSol <Sol.Yukimura@gmail.com>",
  "//": "Frozen vendored copy: never run npm install / npm ci here. A lockfile would negotiate the aligned 0.2.0-rc.2 packages back to 0.1.5-rc.2 and silently break the host. To change a dependency, copy the whole node_modules tree from the host instead.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/state.js",
    "lib/projection.js",
    "lib/plan.js",
    "lib/multi.js",
    "lib/switch.js",
    "lib/routes.js",
    "lib/settings.js",
    "lib/prompts.js",
    "lib/multi-prompt.js",
    "lib/build.js",
    "lib/planfile.js",
    "lib/delegation-gate.js",
    "lib/gate-settings.js",
    "lib/create-plan-fold.js",
    "lib/cursor-plan.js",
    "lib/subagent-todos.js",
    "lib/list-running-agent.js",
    "lib/preset-derive.js",
    "locale/en.json",
    "locale/zh.json",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
